{
  "manifest_version": 3,
  "name": "WebGPU VSR - Video Super Resolution",
  "short_name": "WebGPU VSR",
  "version": "1.1.0",
  "description": "Real-time video super-resolution on Apple Silicon: NVIDIA RTX VSR reconstructed as WebGPU compute shaders.",
  "minimum_chrome_version": "135",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "WebGPU VSR",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["storage", "tabs"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["weights/*.bin", "weights/*.json", "sites/*.json"],
      "matches": ["<all_urls>"]
    }
  ]
}
